# Discord bot configuration
DISCORD_TOKEN=your_discord_bot_token_here
BOT_NAME=OFS Bot

# Environment controls
ENV=production
TEST_GUILD_ID=

# Google Sheets target
SPREADSHEET_ID=your_google_sheet_id_here

# Google Sheets credentials
# For VPS / GitHub-connected hosts, prefer pasting the full service-account JSON
# into GOOGLE_CREDENTIALS_JSON instead of committing a file.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your_project","private_key_id":"..."}

# Local-only alternative:
# Place google_credentials.json in the project root (already gitignored)
